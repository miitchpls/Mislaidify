<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authorize Mislaidify</title>
    <style>
      body {
        margin: 0;
        margin-top: 96px;
        background-color: #121212;
        color: white;
        font-family: Arial, sans-serif;
      }

      .flex-col {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      p {
        margin: 0;
      }

      .title {
        font-weight: 700;
        margin-bottom: 32px;
      }
      .title p {
        font-size: 2rem;
      }

      li {
        padding-top: 4px;
      }

      button {
        width: 270px;
        font-weight: 700;
        background-color: #1ed760;
        padding: 16px 32px 16px 32px;
        border-radius: 32px;
      }
    </style>
  </head>
  <body class="flex-col">
    <div class="title flex-col">
      <span>Allow Spotify to connect to:</span>
      <p>Mislaidify</p>
    </div>

    <div>
      <p>You agree that Mislaidify will be able to:</p>
      <ul>
        <li>Lorem ipsum</li>
        <li>Lorem ipsum</li>
      </ul>
    </div>

    <button>I agree</button>
  </body>

  <script>
    document
      .querySelector("button")
      .addEventListener("click", () =>
        window.location.replace("<%= redirectUrl %>")
      );
  </script>
</html>
